<?xml version="1.0" encoding="utf-8" ?>
<!-- Admin app with UPI alerts: the plain Admin app (src/admin) plus reading the shop UPI app's payment alerts.
     Res and assets come from src/admin (see build.gradle); keep the printer lines in step with src/admin. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Read the shop UPI app's "Received ₹450 from ..." alerts, once the owner allows Notification access -->
    <application>
        <service
            android:name="com.cheesypizza.app.UpiAlertService"
            android:label="Cheesy Pizza · UPI payment alerts"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
    <!-- UPI apps the settings screen offers, when they are installed -->
    <queries>
        <package android:name="com.phonepe.app.business" />
        <package android:name="com.paytm.business" />
        <package android:name="com.google.android.apps.nbu.paisa.merchant" />
        <package android:name="com.bharatpe.app" />
        <package android:name="com.phonepe.app" />
        <package android:name="com.google.android.apps.nbu.paisa.user" />
        <package android:name="net.one97.paytm" />
        <package android:name="in.org.npci.upiapp" />
        <package android:name="com.google.android.apps.messaging" />
    </queries>
</manifest>
